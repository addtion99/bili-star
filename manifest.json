{
  "manifest_version": 3,
  "name": "Bili Star",
  "version": "0.2.0",
  "description": "Keep only high-liked danmaku and special danmaku on Bilibili standard video pages.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Bili Star",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-script.js"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ]
}
